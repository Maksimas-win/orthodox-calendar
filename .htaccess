# Настройки сервера для Hostinger (Apache / LiteSpeed).
# На GitHub Pages этот файл просто игнорируется.

# Открывать index.html, даже если в папке остался default.php от Hostinger
DirectoryIndex index.html index.php

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .svg

# Перенаправление на HTTPS — раскомментируйте, если в hPanel включён SSL,
# а принудительный HTTPS там не настроен
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Сжатие
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

# Кэширование: страница проверяется каждый раз, стили и скрипты — неделю
# (после правки css/js увеличьте ?v= в index.html)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Базовые заголовки безопасности
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Не отдавать служебные файлы, если их случайно загрузили на хостинг
RedirectMatch 404 /\.git
<FilesMatch "^(README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
